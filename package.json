{
  "name": "waypoint",
  "productName": "Waypoint",
  "version": "0.9.0",
  "description": "Notes, projects, docs and tasks in a plain-markdown, git-friendly vault",
  "main": "./out/main/index.js",
  "author": "Bill Lowe",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/copy-excalidraw-assets.mjs",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/copy-excalidraw-assets.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chokidar": "^4.0.3",
    "minisearch": "^7.2.0",
    "simple-git": "^4.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/language": "^6.11.2",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@lezer/common": "^1.5.4",
    "@lezer/highlight": "^1.2.1",
    "@lezer/markdown": "^1.8.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "zustand": "^5.0.6"
  },
  "overrides": {
    "nanoid@<3.3.18": "3.3.20",
    "nanoid@>=4 <5.1.16": "5.1.16",
    "lodash-es": "4.18.1",
    "katex": "0.19.1"
  }
}
